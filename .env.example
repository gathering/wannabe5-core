# php artisan key:generate
APP_KEY=base64:nfTdlWswyvfctT6YNgk92bZaKWs5HfhdcyIXWmJUcuk=

# local is development
APP_ENV=local
# Intended for use in docker containers, meaning `php artisan serve` will accept traffic from any source
SERVER_HOST=0.0.0.0

# devcontainer
DB_HOST=db
DB_USERNAME=laravel
DB_DATABASE=wannabe5
DB_PASSWORD=mydevelopmentexample

# db (loading variables from dev_container, so no need to change here)
POSTGRES_USER=${DB_USERNAME}
POSTGRES_DB=${DB_DATABASE}
POSTGRES_PASSWORD=${DB_PASSWORD}

TELESCOPE_ENABLED=true
# Log to stdout/stderr
LOG_LEVEL=debug
LOG_CHANNEL=errorlog
APP_DEBUG=true

# OIDC browser flow needs a persistent session (not array).
SESSION_DRIVER=file
SESSION_DOMAIN=wannabe5.gathering.org
SESSION_SAME_SITE=lax

# Local Keycloak (see docs/development/local-stack.md and `make stack-up`).
# Realm public key is overwritten by `make keycloak-sync-realm-key` after Keycloak starts.
KEYCLOAK_REALM_PUBLIC_
KEYCLOAK_BASE_URL=http://keycloak.wannabe5.gathering.org:8080
KEYCLOAK_REALM=wannabe
KEYCLOAK_CLIENT_ID=wannabe
KEYCLOAK_CLIENT_SECRET=191b7110-e058-4fb9-b23d-1cc3394f6418
KEYCLOAK_REDIRECT_URI=http://wannabe5.gathering.org:8000/api/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://wannabe5.gathering.org:3000/

# RS256 wannabe_jwt signing (must match frontend AUTH_PUBLIC_KEY).
# Full local-dev keypair lives in env/local-stack.env (`make stack-env`).
AUTH_USER_PUBLIC_KEY=
AUTH_USER_PRIVATE_KEY=

# Optional compatibility adapter targets for legacy microservice endpoints.
BACKEND_COMPAT_TIMEOUT_SECONDS=20
WANNABE_JWT_TTL_MINUTES=15
AUTH_ALLOWED_REDIRECT_HOSTS=wannabe5.gathering.org,localhost,127.0.0.1
BACKEND_COMPAT_ACCESS_URL=
BACKEND_COMPAT_APPLICATION_URL=
BACKEND_COMPAT_AUTH_URL=
BACKEND_COMPAT_COMMUNICATION_URL=
BACKEND_COMPAT_CREW_URL=
BACKEND_COMPAT_PROFILE_URL=
BACKEND_COMPAT_TASKING_URL=

# Communication delivery providers (log/array mailers are used by default in local/test).
COMMUNICATION_FORCE_LOG_DELIVERY=false
COMMUNICATION_SMS_PROVIDER=log
COMMUNICATION_SMS_ENDPOINT=
COMMUNICATION_SLACK_WEBHOOK=
