# Local stack defaults for wannabe5-core + frontend + backend Keycloak.
# Applied by `make stack-env`. Do not use these keys in production.

# Browser-facing hosts (see /etc/hosts). Do not use localhost for OIDC.
APP_URL=http://wannabe5.gathering.org:8000
APP_ENV=local
APP_DEBUG=true
SERVER_HOST=0.0.0.0

# Persist OIDC state across Keycloak redirect (default config is array = lost every request).
SESSION_DRIVER=file
SESSION_DOMAIN=wannabe5.gathering.org
SESSION_SAME_SITE=lax

# No queue worker in the local stack; run jobs inline after login.
QUEUE_CONNECTION=sync

# Docker Compose DB service hostname (do not use 127.0.0.1 inside the app container).
DB_HOST=db
DB_PORT=5432
DB_CONNECTION=pgsql
DB_USERNAME=laravel
DB_DATABASE=wannabe5
DB_PASSWORD=mydevelopmentexample
POSTGRES_USER=laravel
POSTGRES_DB=wannabe5
POSTGRES_PASSWORD=mydevelopmentexample

AUTH_ALLOWED_REDIRECT_HOSTS=wannabe5.gathering.org,localhost,127.0.0.1

KEYCLOAK_BASE_URL=http://keycloak.wannabe5.gathering.org:8080
KEYCLOAK_REALM=wannabe
KEYCLOAK_CLIENT_ID=wannabe
KEYCLOAK_CLIENT_SECRET=191b7110-e058-4fb9-b23d-1cc3394f6418
KEYCLOAK_REDIRECT_URI=http://wannabe5.gathering.org:8000/api/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://wannabe5.gathering.org:3000/
# KEYCLOAK_REALM_PUBLIC_KEY is refreshed by `make keycloak-sync-realm-key` after Keycloak starts.

